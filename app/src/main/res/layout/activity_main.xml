<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0C0C"
    android:orientation="vertical">

    <com.term.dev.view.TerminalView
        android:id="@+id/terminalView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161616"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/extraKeysRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="2dp">

            <Button
                android:id="@+id/btnEsc"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:backgroundTint="#242424"
                android:padding="0dp"
                android:text="ESC"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTab"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#242424"
                android:padding="0dp"
                android:text="TAB"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnCtrl"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#242424"
                android:padding="0dp"
                android:text="CTRL"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAlt"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#242424"
                android:padding="0dp"
                android:text="ALT"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnUp"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#242424"
                android:padding="0dp"
                android:text="▲"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDown"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#242424"
                android:padding="0dp"
                android:text="▼"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLeft"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#242424"
                android:padding="0dp"
                android:text="◀"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRight"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#242424"
                android:padding="0dp"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPipe"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#242424"
                android:padding="0dp"
                android:text="|"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnTilde"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#242424"
                android:padding="0dp"
                android:text="~"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSlash"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#242424"
                android:padding="0dp"
                android:text="/"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDash"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#242424"
                android:padding="0dp"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
